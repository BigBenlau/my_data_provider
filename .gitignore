# 預設忽略所有路徑，只收錄下列原始碼與專案必要檔案。
*
!/.gitignore

# 保留下載與解壓工具，以及分享版與採集版各自使用的交易所 metadata。
!/share_code/
!/share_code/*.py
!/share_code/exchange_info/
!/share_code/exchange_info/*.json
!/tardis_sample/
!/tardis_sample/*.py
!/tardis_sample/.dockerignore
!/tardis_sample/exchange_info/
!/tardis_sample/exchange_info/*.json

# 分析程式與依賴。研究結果、樣本及報告均留在本機。
!/tardis_sample/step1/
!/tardis_sample/step1/*.py
!/tardis_sample/step1/requirements-analysis.txt
!/tardis_sample/step1/README.md
!/tardis_sample/step1/AGENTS.md

# 只收錄各階段的原始碼、已知部署設定與操作文件。
!/tardis_sample/step2/
!/tardis_sample/step2/README.md
!/tardis_sample/step2/AGENTS.md
!/tardis_sample/step2/RUN_01_02.md
!/tardis_sample/step2/Dockerfile
!/tardis_sample/step2/requirements.txt
!/tardis_sample/step2/common/
!/tardis_sample/step2/common/*.py
!/tardis_sample/step2/tests/
!/tardis_sample/step2/tests/*.py
!/tardis_sample/step2/01_collector/
!/tardis_sample/step2/01_collector/*.py
!/tardis_sample/step2/01_collector/settings.json
!/tardis_sample/step2/01_collector/compose.yaml
!/tardis_sample/step2/01_collector/collector.service.example
!/tardis_sample/step2/01_collector/DOCKER_DEPLOYMENT.md
!/tardis_sample/step2/01_collector/SOURCE_COVERAGE.md
!/tardis_sample/step2/01_collector/collectors/
!/tardis_sample/step2/01_collector/collectors/*.py
!/tardis_sample/step2/02_normalize_tardis/
!/tardis_sample/step2/02_normalize_tardis/*.py
!/tardis_sample/step2/02_normalize_tardis/mappers/
!/tardis_sample/step2/02_normalize_tardis/mappers/*.py
!/tardis_sample/step2/03_compare/
!/tardis_sample/step2/03_compare/*.py

# 固定版本的上游原始碼、授權與核對紀錄。
!/tardis_sample/step2/02_normalize_tardis/reference/
!/tardis_sample/step2/02_normalize_tardis/reference/*.ts
!/tardis_sample/step2/02_normalize_tardis/reference/LICENSE
!/tardis_sample/step2/02_normalize_tardis/reference/README.md
